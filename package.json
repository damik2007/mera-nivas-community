{
  "name": "mycommunity",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@mycommunity/api",
    "dev:web": "npm run dev --workspace=@mycommunity/web",
    "db:generate": "npm run generate --workspace=@mycommunity/database",
    "db:migrate": "npm run migrate --workspace=@mycommunity/database",
    "db:seed": "npm run seed --workspace=@mycommunity/database",
    "db:create-admin": "npm run create-admin --workspace=@mycommunity/database",
    "setup": "npm install && npm run db:generate && npm run db:migrate && npm run db:seed",
    "build": "npm run build --workspace=@mycommunity/database && npm run build --workspace=@mycommunity/api && npm run build --workspace=@mycommunity/web",
    "build:api": "esbuild apps/api/src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=deploy/api/app.js --external:bufferutil --external:utf-8-validate",
    "build:deploy": "node scripts/build-deploy.mjs",
    "deploy:env": "node scripts/print-env.mjs",
    "db:admin-sql": "npm run admin-sql --workspace=@mycommunity/database"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "esbuild": "^0.25.0"
  }
}
