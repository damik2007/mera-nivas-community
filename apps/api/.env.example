PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database — MySQL/MariaDB connection string (packages/database uses this too — keep in sync, see packages/database/.env)
# Local dev:
DATABASE_URL="mysql://root:@127.0.0.1:3306/mycommunity"
# Namecheap/cPanel shared hosting looks like:
# DATABASE_URL="mysql://cpaneluser_dbuser:yourpassword@localhost:3306/cpaneluser_mycommunity"

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# QR signing
QR_SIGNING_SECRET=change-me-qr

# Payments (leave unset to use the built-in mock provider)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=

# Notifications (mocked; wire real credentials to go live)
FCM_SERVER_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=

# AI invitation image generation (optional — falls back to template generator if unset)
AI_IMAGE_API_KEY=
AI_IMAGE_API_URL=
